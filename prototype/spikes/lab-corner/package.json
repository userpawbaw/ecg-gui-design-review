{
  "name": "ecg-spike-lab-corner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Spike: isometric baked lab corner with 360° drag-controlled light. Not ECG product UI.",
  "scripts": {
    "scene": "python3 ../../../scripts/blender/build_lab_corner.py --out prototype/spikes/lab-corner/public/scene --azimuths 8 --size 1024 --samples 256 --passes sky,bounce && python3 ../../../scripts/blender/package_lab_corner.py public/scene",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4190",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {"three": "0.186.1"},
  "devDependencies": {"@playwright/test": "^1.56.0", "@types/three": "^0.186.0", "typescript": "^5.9.0", "vite": "^7.0.0"}
}
