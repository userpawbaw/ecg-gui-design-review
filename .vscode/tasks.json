{
  // VS Code: Ctrl+Shift+P → "Tasks: Run Task" → 아래 이름 선택. 터미널에 명령을 칠 필요가 없다.
  // 모든 작업은 scripts/local/run.mjs를 거치므로 PowerShell의 &&, python3, cp949 문제를 피한다.
  "version": "2.0.0",
  // Windows: 작업은 cmd.exe로 실행 — PowerShell 실행 정책(npm.ps1 차단)과 && 미지원을 피한다.
  "windows": {"options": {"shell": {"executable": "cmd.exe", "args": ["/d", "/c"]}}},
  "tasks": [
    {"label": "① 환경 점검 (doctor)", "type": "shell", "command": "npm run doctor", "problemMatcher": []},
    {"label": "② R1 Story 실행", "type": "shell", "command": "npm run story", "isBackground": true, "problemMatcher": [], "group": {"kind": "build", "isDefault": true}},
    {"label": "③ R1 Story 검사 (빌드·단위·브라우저)", "type": "shell", "command": "npm run story:check", "problemMatcher": [], "group": {"kind": "test", "isDefault": true}},
    {"label": "저장소 전체 테스트 (기록·인코딩·호환성)", "type": "shell", "command": "npm test", "problemMatcher": []},
    {"label": "video-scrub spike 실행", "type": "shell", "command": "npm run spike -- video-scrub", "isBackground": true, "problemMatcher": []},
    {"label": "attic spike 실행", "type": "shell", "command": "npm run spike -- attic", "isBackground": true, "problemMatcher": []},
    {"label": "처음 한 번: Playwright 브라우저 설치", "type": "shell", "command": "npm run browsers", "problemMatcher": []},
    {"label": "처음 한 번: 영상 도구 Python 패키지 설치", "type": "shell", "command": "npm run py:setup", "problemMatcher": []}
  ]
}
